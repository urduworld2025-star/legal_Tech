MAX_UPLOAD_MB=25

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Free signup + token: https://www.courtlistener.com/profile/api-token/
COURTLISTENER_API_TOKEN=

# Stripe billing - see README's "Billing (Stripe)" section. Leave unset to run
# with billing simply unconfigured (checkout/portal routes return 503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
FRONTEND_BASE_URL=http://localhost:5173
