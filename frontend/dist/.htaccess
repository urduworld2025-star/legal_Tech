RewriteEngine On

# API: proxy /legal_document/* to the standalone uvicorn process (strips the prefix)
RewriteRule ^legal_document/(.*)$ http://127.0.0.1:30001/$1 [P,L]

# SPA: everything that isn't a real file/dir falls back to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
